# Google Cloud OAuth client (type: Web application). See README.md for setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random string, at least 32 characters. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Public URL of this app; the OAuth redirect URI is ${APP_URL}/api/auth/callback.
# Optional on Vercel (defaults to the production domain). Defaults to http://localhost:3000.
APP_URL=http://localhost:3000

# Optional: set to 1 for a public showcase that only serves sample data.
DEMO_ONLY=

# Optional: repository linked from the footer (defaults to the upstream repo).
NEXT_PUBLIC_REPO_URL=
